{
  "name": "webcraftdg/creer-mon-site-facilement",
  "description": "Projet squelette site  basé sur FractalCMS – prêt à l'emploi pour démarrer rapidement.",
  "keywords": ["site", "création", "fractal-cms", "fractalCms"],
  "homepage": "https://github.com/webcraftdg/creer-mon-site-facilement",
  "type": "project",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/webcraftdg/creer-mon-site-facilement/issues",
    "source": "https://github.com/webcraftdg/creer-mon-site-facilement"
  },
  "authors": [
    {
      "name": "David Ghyse",
      "email": "davidg@webcraftdg.fr"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "vlucas/phpdotenv": "^5.6",
    "webcraftdg/fractal-cms-content": "^v2.2.0"
  },
  "config": {
    "process-timeout": 1800,
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "autoload": {
    "psr-4": {
      "console\\": "console",
      "app\\": "common",
      "webapp\\": "webapp"
    }
  },
  "scripts": {
    "post-install-cmd": [
    ]
  }
}
